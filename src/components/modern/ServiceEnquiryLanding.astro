---
import Base from '../../layouts/Base.astro';
import {site} from '../../data/site.mjs';
const {service}=Astro.props;
const website=service.slug==='website-design-northern-ireland';
const content=website?{
  eyebrow:'WEBSITE DESIGN & DEVELOPMENT · NORTHERN IRELAND',headline:'A better website.',accent:'A clearer next step.',
  deck:'Websites that explain your business, show what makes you different and make it easy for the right customers to get in touch.',
  intro:'Planning a new website or replacing one that no longer does your business justice? Talk directly with Glen about your customers, your content and what the website needs to achieve.',
  capabilities:['New business websites','Website redesigns','Search & enquiry journeys'],
  formTitle:'Let’s talk about your website.',label:'What do you need from your website?',placeholder:'A new site or a redesign? Tell us about the business and what you want visitors to do.',button:'Discuss my website',
  evidence:'A website with a job to do.',cards:[['Explain your offer','Clear content and navigation that help customers understand your services.'],['Make a strong impression','Responsive layouts, considered design and accessible interactions across devices.'],['Make enquiries easier','Fast, indexable pages and a straightforward route from visitor to conversation.']],
  process:'We’ll discuss your audience, existing website, content and priorities. Then we can agree a focused scope, delivery approach and what you’ll need to manage after launch.',
  faqs:[['Can you redesign my existing website?','Yes. We can review what works, what is holding it back and whether to improve the existing site or rebuild it.'],['Will the website work well for search?','We build with indexable content, useful metadata, a sitemap and fast pages. Search rankings depend on competition, content and reputation as well as the website itself.'],['Can the website connect to other systems?','Yes. Enquiry workflows, booking services, APIs and other integrations can form part of the agreed scope.']],
  previewTitle:'FROM FIRST VISIT TO ENQUIRY',previewLeft:'Explain your business',previewRight:'Start a conversation',previewCaption:'Give every page a clear purpose.'
}:{
  eyebrow:'BESPOKE SOFTWARE & APPLICATIONS · NORTHERN IRELAND',headline:'Software that fits.',accent:'Built around your business.',
  deck:'Custom applications, connected systems and practical automation for the way your business actually works.',
  intro:'Outgrowing spreadsheets or working around disconnected tools? Talk directly with Glen about the workflow, the people using it and where better software could save time or remove friction.',
  capabilities:['Custom web applications','API integration','Workflow automation'],
  formTitle:'What would you like to improve?',label:'Tell us about the software or workflow',placeholder:'What happens today, who uses it and what would you like to improve? A short outline is enough.',button:'Discuss my software project',
  evidence:'Turn a difficult process into useful software.',cards:[['Business applications','Operational dashboards, internal tools and client portals designed around real tasks.'],['Connected systems','Integrate APIs and existing platforms to reduce repeated data entry and disconnected information.'],['A practical first release','Define the problem, agree priorities and build a maintainable foundation for what comes next.']],
  process:'We’ll map the current process, identify the users and integrations, and agree what success looks like. A focused first release gives you a useful starting point before investing in a larger programme.',
  faqs:[['Do I need a full specification?','No. Examples of the current process, the people involved and the outcome you need are a useful place to start.'],['Can you work with our existing software or team?','Yes. Consultancy can include React and TypeScript engineering, API integration and delivery alongside existing product, backend and DevOps teams.'],['How much does bespoke software cost?','The workflow, integrations, data migration and ongoing support all affect the scope. We agree the commercial approach and deliverables before development begins.']],
  previewTitle:'A WORKFLOW, MADE SIMPLER',previewLeft:'Your people & processes',previewRight:'One connected system',previewCaption:'Make the software fit the work.'
};
---
<Base title={service.title} description={content.deck+' Modern Software, Portadown, Northern Ireland.'} structuredData={{'@type':'Service',name:service.title,provider:{'@id':site.url+'/#organization'},areaServed:{'@type':'Place',name:'Northern Ireland'},url:site.url+'/'+service.slug}}>
  <section class="service-lead wrap">
    <div class="service-intro"><span class="eyebrow">{content.eyebrow}</span><h1>{content.headline}<br/><em>{content.accent}</em></h1><p class="service-deck">{content.deck}</p><p>{content.intro}</p><div class="capabilities">{content.capabilities.map(text=><span>{text}</span>)}</div><div class="workflow" aria-label="Illustrative service journey"><div class="eyebrow">{content.previewTitle}</div><div class="workflow-path"><strong>{content.previewLeft}</strong><span aria-hidden="true">→</span><strong>{content.previewRight}</strong></div><p>{content.previewCaption}</p></div></div>
    <form id="service-enquiry" class="service-form" action="/api/contact" method="post" data-button={content.button} data-service={service.slug}>
      <span class="eyebrow">LET’S START WITH A CONVERSATION</span><h2>{content.formTitle}</h2><p>A few details are enough. Glen will reply directly.</p>
      <input type="hidden" name="service" value={service.label}/><input type="hidden" name="source" value="Website"/><input type="hidden" name="medium"/><input type="hidden" name="campaign"/>
      <label>Your name *<input name="name" autocomplete="name" required maxlength="120"/></label><label>Email address *<input name="email" type="email" autocomplete="email" required maxlength="254"/></label><label>{content.label} *<textarea name="message" rows="4" required minlength="20" maxlength="6000" placeholder={content.placeholder}></textarea></label><label>Phone number <span class="optional">(optional)</span><input name="phone" type="tel" autocomplete="tel" maxlength="50"/></label>
      <div class="form-trap" aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off"/></label></div><p class="form-privacy">We’ll use these details to reply. You won’t be added to a marketing list. <a href="/privacy">Privacy information</a>.</p><button class="button" type="submit">{content.button}</button><p id="service-form-status" role="status" aria-live="polite"></p><p class="direct">Prefer email? <a href={'mailto:'+site.email}>{site.email}</a></p>
    </form>
  </section>
  <section class="service-details wrap"><span class="eyebrow">{website?'DESIGNED TO WORK FOR YOUR BUSINESS':'BUILT AROUND REAL WORK'}</span><h2>{content.evidence}</h2><div class="three-grid">{content.cards.map(([title,text])=><article class="detail-card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  {!website&&<section class="service-work wrap"><span class="eyebrow">EXPERIENCE BEHIND THE CONVERSATION</span><h2>Engineering alongside real product teams.</h2><p>Glen’s consultancy engagements include frontend delivery and connected business systems. Explore the role and contribution behind each project.</p><div class="work-links"><a href="/work/loweconex">LoweConex ↗</a><a href="/work/sensoteq">Sensoteq ↗</a><a href="/work/terraquest">TerraQuest ↗</a></div></section>}
  <section class="service-process wrap"><div><span class="eyebrow">A PRACTICAL FIRST STEP</span><h2>Start with the problem.<br/>Agree the next step.</h2><p>{content.process}</p><p>Based in Portadown, working across Northern Ireland and the UK. Client meetings at CIDO Craigavon are available by appointment.</p><a href={site.personal+'/about'}>Meet Glen and explore his background ↗</a></div><div class="questions">{content.faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <script>
    const form=document.querySelector<HTMLFormElement>('#service-enquiry');
    if(form){
      const params=new URLSearchParams(location.search);
      for(const [field,param] of [['source','utm_source'],['medium','utm_medium'],['campaign','utm_campaign']]){const input=form.elements.namedItem(field) as HTMLInputElement|null;const value=params.get(param);if(input&&value)input.value=value.slice(0,180);}
      form.addEventListener('submit',async event=>{
        event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;if(button.disabled)return;const status=document.querySelector<HTMLElement>('#service-form-status')!;button.disabled=true;button.textContent='Sending…';status.textContent='';
        try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const data=await response.json();if(!response.ok)throw new Error(data.message||'Unable to send. Please try again or email Glen.');form.reset();status.textContent='Thank you. Your enquiry has been sent to Glen. He’ll reply using the details you provided.';window.dispatchEvent(new CustomEvent('modern-software:enquiry-sent',{detail:{service:form.dataset.service}}));}
        catch(error){status.textContent=error instanceof Error?error.message:'Unable to send. Please email Glen directly.';}
        finally{button.disabled=false;button.textContent=form.dataset.button!;}
      });
    }
  </script>
  <style>
    .service-lead{display:grid;grid-template-columns:1.15fr 1fr;gap:7%;padding-block:70px 80px;align-items:start}.service-intro h1{font-size:clamp(46px,5vw,72px);margin:25px 0}.service-intro p,.service-process p,.service-work p{font-size:16px;line-height:1.75}.service-intro .service-deck{font-size:20px;color:#d1dfd5;margin-bottom:22px}.capabilities{display:flex;gap:10px;flex-wrap:wrap;margin:26px 0}.capabilities span{font-size:14px;padding:9px 12px;border:1px solid var(--line);border-radius:4px;color:var(--mint)}.service-form{padding:32px;background:var(--panel);border:1px solid #657b6b;border-radius:12px;box-shadow:0 24px 70px #0002}.service-form h2{font-size:36px;margin:15px 0;line-height:1.15}.service-form p{font-size:15px;line-height:1.6}.service-form label{display:block;font-size:16px;margin-top:20px;color:#e1e9e3}.service-form input,.service-form textarea{font-size:16px}.optional{color:var(--muted);font-size:14px}.service-form .form-privacy{font-size:14px;margin-block:22px}.service-form a,.service-process a{color:var(--mint);text-decoration:underline;text-underline-offset:4px}.service-form .button{font-size:16px;width:100%;justify-content:center;padding:18px}.service-form .direct{font-size:14px;margin:22px 0 0;overflow-wrap:anywhere}#service-form-status:empty{display:none}#service-form-status{margin:20px 0 0;color:var(--mint)}.workflow{border:1px solid var(--line);background:#1e2822;border-radius:12px;padding:24px;margin-top:32px}.workflow-path{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:30px 0;font-size:17px}.workflow-path span{color:var(--pink);font-size:28px}.workflow p{color:var(--mint);font-size:14px}.service-details{padding-block:55px;border-block:1px solid var(--line)}.service-details h2,.service-work h2{font-size:38px;margin:20px 0 30px}.service-work{padding-block:50px;border-bottom:1px solid var(--line)}.work-links{display:flex;gap:20px;flex-wrap:wrap;margin-top:25px}.work-links a{border:1px solid var(--line);padding:18px 24px;color:var(--mint);border-radius:7px}.work-links a:hover{border-color:var(--mint)}.service-process{display:grid;grid-template-columns:1fr 1fr;gap:8%;padding-block:65px 85px}.service-process h2{margin:20px 0}.service-process a{display:inline-block;margin-top:24px;font-size:16px}.questions details{border-top:1px solid var(--line);padding:23px 0}.questions summary{font-size:18px;cursor:pointer;line-height:1.5}.questions p{margin-top:16px}@media(max-width:850px){.service-lead{grid-template-columns:1fr;gap:36px;padding-block:40px}.service-intro h1{font-size:clamp(44px,9vw,68px)}.service-form{padding:26px 22px}.service-process{grid-template-columns:1fr;gap:35px;padding-block:45px}.service-details h2,.service-work h2{font-size:32px}.workflow{display:none}}
  </style>
</Base>

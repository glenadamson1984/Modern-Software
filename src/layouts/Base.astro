---
import '../styles/modern.css';import Logo from '../components/modern/Logo.astro';import {site,services} from '../data/site.mjs';
const {title='Bespoke Software Development & Consultancy | Northern Ireland',description='Bespoke applications, operational systems and experienced software consultancy. Modern Software, Portadown, Northern Ireland.',noindex=false,structuredData}=Astro.props;
const path=Astro.url.pathname.replace(/\/$/,'')||'/';const canonical=new URL(path,site.url).href;
const graph={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':site.url+'/#organization',name:site.name,url:site.url,logo:site.url+'/brand/mark.svg',email:site.email,founder:{'@id':site.personal+'/#person'},address:{'@type':'PostalAddress',addressLocality:'Portadown',addressRegion:'Northern Ireland',addressCountry:'GB'},sameAs:[site.personal,'https://www.linkedin.com/company/modern-software']},{'@type':'WebSite',url:site.url,name:site.name,publisher:{'@id':site.url+'/#organization'}},...(structuredData?[structuredData]:[])]};
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title.includes('Modern Software')?title:title+' | Modern Software'}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/brand/mark.svg"/><meta name="theme-color" content="#181b19"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={site.url+'/brand/social.png'}/><meta property="og:locale" content="en_GB"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={site.url+'/brand/social.png'}/><link rel="preload" href="/fonts/Inter-Variable.ttf" as="font" type="font/ttf" crossorigin/><script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">Skip to content</a><header class="header wrap"><Logo/><nav aria-label="Main navigation"><a href="/services" aria-current={path==='/services'?'page':undefined}>What we do</a><a href="/portfolio" aria-current={path==='/portfolio'?'page':undefined}>Our work</a><a href="/about" aria-current={path==='/about'?'page':undefined}>About</a><a href="/insights">Insights</a></nav><a class="button small" href="/contact">Let’s talk <span>↗</span></a><details class="mobile-nav"><summary>Menu +</summary><nav aria-label="Mobile navigation"><a href="/services">What we do</a><a href="/portfolio">Our work</a><a href="/about">About</a><a href="/insights">Insights</a><a href="/contact">Start a conversation ↗</a></nav></details></header><main id="main"><slot/></main><footer class="footer wrap"><div class="footer-top"><Logo/><p>Thoughtful software.<br/>Built around your business.</p><a href={site.personal}>Meet Glen & explore the portfolio ↗</a></div><div class="footer-grid"><div><span class="eyebrow">BASED IN NORTHERN IRELAND</span><p>Portadown. Working with businesses<br/>and product teams across the UK.</p><a href={'mailto:'+site.email}>{site.email}</a><a href="tel:+447921568808">{site.phone}</a></div><div><span class="eyebrow">WHAT WE DO</span>{services.map(s=><a href={'/'+s.slug}>{s.label}</a>)}</div><div><span class="eyebrow">EXPLORE</span><a href="/portfolio">Selected work</a><a href="/about">About Modern Software</a><a href={site.personal+'/about'}>About Glen ↗</a><a href="/contact">Start a conversation</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Modern Software</span><div><a href="/privacy">Privacy</a><a href="/leads" rel="nofollow">Admin access</a></div></div></footer><script>
if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('revealed');observer.unobserve(entry.target)}}),{threshold:.08});document.querySelectorAll('[data-reveal]').forEach(el=>{el.classList.add('will-reveal');observer.observe(el)})}
</script></body></html>

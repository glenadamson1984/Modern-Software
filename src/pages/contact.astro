---
import Base from '../layouts/Base.astro';import {services,site} from '../data/site.mjs';
---
<Base title="Discuss Your Software Project" description="Tell Modern Software about your software project, consultancy needs or website. Speak directly with Glen Adamson in Portadown, Northern Ireland."><section class="page-hero wrap"><span class="eyebrow">LET’S START WITH A CONVERSATION</span><h1>What have you<br/>got in mind<span class="pink">?</span></h1><p>A problem to solve, a product to build or a team that needs support. Tell us a little about it.</p></section><section class="contact-layout wrap"><form id="enquiry" action="/api/contact" method="post"><div class="form-heading"><h2>Tell us about your project.</h2><span>Fields marked * are required.</span></div><div class="form-grid"><label>Your name *<input name="name" autocomplete="name" required maxlength="120"/></label><label>Email address *<input name="email" type="email" autocomplete="email" required maxlength="254"/></label><label>Company<input name="company" autocomplete="organization" maxlength="180"/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" maxlength="50"/></label><label>What can we help with?<select name="service"><option value="">Please choose</option>{services.map(s=><option>{s.label}</option>)}<option>Something else / not sure yet</option></select></label><label>Indicative project budget<select name="budget"><option>Not decided yet</option><option>Under £5,000</option><option>£5,000–£15,000</option><option>£15,000–£30,000</option><option>£30,000+</option><option>Consultancy / ongoing engagement</option></select></label></div><label>What would you like to improve or build? *<textarea name="message" rows="6" required minlength="20" maxlength="6000" placeholder="The current process, who uses it, and what you would like to change…"></textarea></label><label>Ideal timescale<input name="timescale" maxlength="180" placeholder="For example: exploring options, next quarter, or a fixed deadline"/></label><div class="form-trap" aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off"/></label></div><p class="form-privacy">We’ll use these details to respond to your enquiry. Please don’t include passwords or confidential customer data. <a href="/privacy">How we handle your information</a>.</p><button class="button" type="submit">Send your enquiry <span>↗</span></button><p id="form-status" role="status" aria-live="polite"></p></form><aside><span class="eyebrow">DIRECT TO GLEN</span><h2>Good software starts<br/>with good questions.</h2><p>You don’t need a complete specification. A clear description of the problem is a useful starting point.</p><a href={'mailto:'+site.email}>{site.email}</a><a href="tel:+447921568808">{site.phone}</a><div class="contact-next"><span class="eyebrow">WHAT HAPPENS NEXT</span><ol><li>Glen reviews your enquiry.</li><li>We discuss the problem and whether we’re a good fit.</li><li>We agree a sensible next step and scope.</li></ol></div><a class="text-link" href="https://www.glenadamson.co.uk/about">Get to know Glen first ↗</a></aside></section><script>
const form=document.querySelector<HTMLFormElement>('#enquiry');const select=form?.querySelector<HTMLSelectElement>('select[name="service"]');const requested=new URLSearchParams(location.search).get('service');if(select&&requested&&Array.from(select.options).some(option=>option.value===requested))select.value=requested;
form?.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;const status=document.querySelector<HTMLElement>('#form-status')!;button.disabled=true;button.textContent='Sending…';status.textContent='';try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const data=await response.json();if(!response.ok)throw new Error(data.message||'Unable to send. Please try again or email Glen directly.');window.dispatchEvent(new CustomEvent('modern-software:enquiry-sent'));form.reset();status.textContent='Thank you. Your enquiry has been sent to Glen.';}catch(error){status.textContent=error instanceof Error?error.message:'Unable to send. Please email Glen directly.';}finally{button.disabled=false;button.textContent='Send your enquiry ↗';}});
</script></Base>

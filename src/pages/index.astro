---
import {Image} from 'astro:assets';
import glen from '../assets/glen.png';
import Base from '../layouts/Base.astro';import CTA from '../components/modern/CTA.astro';import {services,work} from '../data/site.mjs';
---
<Base><section class="hero wrap"><div class="hero-copy"><span class="eyebrow"><i class="status-dot"/> SOFTWARE DEVELOPMENT & CONSULTANCY / NORTHERN IRELAND</span><h1>Good software.<br/>Less friction.<br/><em>More possibility.</em></h1><p>Bespoke applications, connected systems and experienced consultancy. We turn complex workflows into software that makes sense.</p><div class="actions"><a class="button" href="/contact">Let’s talk about your project <span>↗</span></a><a class="text-link" href="/portfolio">Explore the work <span>↓</span></a></div><div class="hero-footnote"><span>BASED IN PORTADOWN</span><span>WORKING WITH BUSINESSES & PRODUCT TEAMS</span></div></div><div class="hero-art" aria-label="Illustration of connected business workflows"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-caption">FROM FRICTION TO FLOW</div><div class="flow-card"><span class="flow-icon">↳</span><div><small>THE STARTING POINT</small><strong>A better way to work.</strong></div><span class="flow-dot"></span></div><div class="flow-connector"></div><div class="flow-core"><img src="/brand/mark.svg" width="60" height="60" alt=""/><span>UNDERSTAND<br/><b>DESIGN. BUILD.</b><br/>REFINE</span><i>+</i></div><div class="flow-output"><div><span>01</span><strong>Useful interfaces</strong><i>↗</i></div><div><span>02</span><strong>Connected systems</strong><i>↗</i></div><div><span>03</span><strong>Clearer decisions</strong><i>↗</i></div></div><div class="art-bottom"><span class="status-dot"/> PEOPLE + PROCESS + TECHNOLOGY</div></div></section><section class="experience-strip"><div class="wrap"><span>CONSULTANCY EXPERIENCE WITH</span><a href="https://www.loweconex.com/">LoweConex ↗</a><a href="https://www.sensoteq.com/">Sensoteq ↗</a><a href="https://www.terraquest.co.uk/">TerraQuest ↗</a></div></section><section class="section wrap" data-reveal><div class="section-top"><span class="eyebrow">01 / WHAT WE DO</span><span class="micro">THE RIGHT TOOLS. THE RIGHT APPROACH.</span></div><div class="section-intro"><h2>Built for the way<br/>your business works<span class="pink">.</span></h2><p>Some challenges need a new application. Others need an experienced engineer, a better integration or a clearer website. We start with the problem.</p></div><div class="service-grid">{services.map((s,i)=><a class="service-card" href={'/'+s.slug}><span class="card-top">0{i+1}<span>↗</span></span><h3>{s.label}</h3><p>{s.intro}</p><span class="service-explore">Explore the service <span>→</span></span></a>)}</div></section><section class="section wrap" data-reveal><div class="section-top"><span class="eyebrow">02 / SELECTED WORK</span><a class="text-link" href="/portfolio">More of the work ↗</a></div><div class="section-intro"><h2>Real workflows.<br/>Hands-on experience<span class="pink">.</span></h2><p>From operational dashboards to connected systems and public-service applications. Selected consultancy engagements through Modern Software.</p></div><div class="work-grid">{work.slice(0,2).map(item=><a class="work-card" href={'/work/'+item.slug}><div class="work-image"><Image src={item.optimized} format="webp" quality={85} alt={item.name+' application interface'} width="800" height="500" loading="lazy"/><span>VIEW THE WORK ↗</span></div><div class="work-caption"><div><span class="eyebrow">CONSULTANCY ENGAGEMENT</span><h3>{item.name}</h3><p>{item.title}</p></div><span>↗</span></div></a>)}</div></section><section class="founder-section wrap" data-reveal><a class="portrait-frame" href="https://www.glenadamson.co.uk/about"><Image src={glen} format="webp" quality={85} width="460" height="460" alt="Pixel portrait of Glen Adamson, founder of Modern Software" loading="lazy"/><span>THE PERSON BEHIND THE SOFTWARE ↗</span></a><div><span class="eyebrow">03 / DIRECT EXPERIENCE. DIRECT CONVERSATIONS.</span><h2>Hi, I’m Glen<span class="pink">.</span><br/>Let’s make it work.</h2><p>I founded Modern Software in 2021. I combine hands-on engineering with product thinking, technical leadership and a curiosity for how businesses work.</p><p>You’ll speak directly with the person helping shape and build the solution. Clear conversations, considered decisions and working software.</p><a class="text-link" href="https://www.glenadamson.co.uk/about">My story, experience & personal projects ↗</a></div></section><section class="section process wrap" data-reveal><div class="section-top"><span class="eyebrow">04 / HOW WE WORK</span><span class="micro">CLARITY BEFORE COMPLEXITY</span></div><h2>A sensible route from<br/>idea to something useful<span class="pink">.</span></h2><div class="process-grid">{[['Understand','The people, the process and the problem worth solving.'],['Shape','A clear scope, the right approach and an agreed first release.'],['Build','Working increments, regular reviews and meaningful testing.'],['Improve','A considered launch, handover and a plan for what comes next.']].map(([title,text],i)=><div><span>0{i+1} ──</span><h3>{title}</h3><p>{text}</p></div>)}</div></section><CTA/></Base>

---
import ServiceEnquiryLanding from '../components/modern/ServiceEnquiryLanding.astro';import Base from '../layouts/Base.astro';import CTA from '../components/modern/CTA.astro';import AppDevelopmentLanding from '../components/modern/AppDevelopmentLanding.astro';import {services,site} from '../data/site.mjs';
export function getStaticPaths(){return services.map(service=>({params:{service:service.slug},props:{service}}));}const {service:s}=Astro.props;
const faqs=[['Do I need a finished specification?','No. We can begin with your current workflow, examples and the outcome you want, then turn those into a scoped plan.'],['Can you work with an existing system or team?','Yes. Previous engagements include engineering alongside product, design, backend and DevOps colleagues. A technical review can establish what needs to change.'],['How are projects priced?','Scope, integrations, data migration and ongoing support all affect the price. We agree the commercial approach and deliverables before development begins.']];
---
{s.slug==='mobile-app-development'?<AppDevelopmentLanding/>:['website-design-northern-ireland','software-development-northern-ireland'].includes(s.slug)?<ServiceEnquiryLanding service={s}/>:<Base title={s.title} description={s.intro+' Modern Software, Portadown.'} structuredData={{'@type':'Service',name:s.title,provider:{'@id':site.url+'/#organization'},areaServed:{'@type':'Place',name:'Northern Ireland'},url:site.url+'/'+s.slug}}><section class="page-hero wrap"><a class="eyebrow" href="/services">WHAT WE DO / {s.label}</a><h1>{s.title}<span class="pink">.</span></h1><p>{s.intro}</p><a class="button" href={'/contact?service='+encodeURIComponent(s.label)}>Discuss your project <span>↗</span></a></section><section class="section wrap"><div class="section-intro"><h2>{s.lead}</h2><p>{s.description}</p></div><div class="three-grid">{s.points.map(([title,text])=><article class="detail-card"><h3>{title}</h3><p>{text}</p></article>)}</div></section><section class="section wrap split-content"><div><span class="eyebrow">A CLEAR PROCESS</span><h2>From the first<br/>conversation onwards.</h2><p>Agree what success looks like and work towards it in practical steps.</p></div><ol class="steps">{['Understand the workflow, the people and the priorities.','Agree a focused first release, scope and acceptance criteria.','Build, review and test working increments together.','Plan deployment, handover and ongoing improvements.'].map((step,i)=><li><span>0{i+1}</span><p>{step}</p></li>)}</ol></section><section class="section wrap faq"><span class="eyebrow">A FEW USEFUL ANSWERS</span><h2>Before we begin<span class="pink">.</span></h2>{faqs.map(([question,answer])=><details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</section><section class="wrap related"><span class="eyebrow">RELATED SERVICES</span>{services.filter(other=>other.slug!==s.slug).map(other=><a href={'/'+other.slug}>{other.label} ↗</a>)}</section><CTA/></Base>}

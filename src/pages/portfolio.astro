---
import {Image} from 'astro:assets';
import glen from '../assets/glen.png';
import Base from '../layouts/Base.astro';import CTA from '../components/modern/CTA.astro';import {work} from '../data/site.mjs';
---
<Base title="Software Development Work & Interactive Prototypes" description="Selected software consultancy work with LoweConex, Sensoteq and TerraQuest, plus working portfolio demonstrations by Glen Adamson."><section class="page-hero wrap"><span class="eyebrow">SELECTED WORK</span><h1>From the workflow<br/>to the working software<span class="pink">.</span></h1><p>Consultancy engagements and independent experiments. A closer look at the thinking and engineering behind the interface.</p></section><section class="wrap work-grid">{work.map(item=><a class="work-card" href={'/work/'+item.slug}><div class="work-image"><Image src={item.optimized} format="webp" quality={85} alt={item.name+' application interface'} width="800" height="500" loading="lazy"/><span>EXPLORE THE ENGAGEMENT ↗</span></div><div class="work-caption"><div><span class="eyebrow">CONSULTANCY ENGAGEMENT</span><h2>{item.name}</h2><p>{item.title}</p></div><span>↗</span></div></a>)}</section><section class="section wrap"><div class="section-top"><span class="eyebrow">OUR PRODUCTS</span><span class="micro">OWNED AND DEVELOPED BY MODERN SOFTWARE</span></div><a class="work-card product-feature" href="https://www.seagprep.co.uk"><div class="work-image"><img src="/brand/nextstep.jpg" alt="SEAGPrep independent English and maths practice platform" width="1265" height="711" loading="lazy"/><span>EXPLORE SEAGPREP</span></div><div class="work-caption"><div><span class="eyebrow">OUR OWN PRODUCT · EARLY ACCESS</span><h2>SEAGPrep</h2><p>Independent SEAG English and maths practice for Northern Ireland families. Original practice papers, worked explanations and a private parent dashboard for following progress over time.</p><p>Built and owned by Modern Software. The free pilot is live; the full paper programme and paid membership are being developed.</p></div></div></a></section><section class="section wrap"><div class="section-top"><span class="eyebrow">INDEPENDENT PROTOTYPES</span><span class="micro">TRY THE WORKFLOW</span></div><div class="work-grid">{[{name:'Modern Warehouse',img:'/brand/warehouse.jpg',href:'https://modern-warehouse.vercel.app',text:'React and TypeScript receiving dashboard for checking parcels and recording discrepancies. The live prototype uses browser-local fictional data; its Laravel API is built locally.'},{name:'Salon Daybook',img:'/brand/salon.jpg',href:'https://www.glenadamson.co.uk/demos/salon-ops/index.html',text:'Independent Ember.js appointment-board prototype with stylist filters, check-in and booking clash checks. Fictional clients and resettable scenarios.'}].map(item=><a class="work-card" href={item.href}><div class="work-image"><img src={item.img} alt={item.name+' prototype'} width="1117" height="820" loading="lazy"/><span>TRY THE PROTOTYPE ↗</span></div><div class="work-caption"><div><span class="eyebrow">{item.owned?'OWNED PRODUCT / EARLY ACCESS':'PORTFOLIO CONCEPT / FICTIONAL DATA'}</span><h2>{item.name}</h2><p>{item.text}</p></div><span>↗</span></div></a>)}</div><p class="muted">The operational demos include reset controls. SEAGPrep lets parents clear their practice history. Explore source links and more experiments in <a href="https://www.glenadamson.co.uk/portfolio">Glen’s personal portfolio ↗</a>.</p></section><CTA/></Base>
